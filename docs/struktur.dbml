Enum "user_role" {
  "HUB_ADMIN"
  "SUPER_ADMIN"
}

Enum "courier_fleet_type" {
  "MOTORCYCLE"
  "VAN"
}

Enum "courier_status" {
  "STANDBY"
  "ON_DUTY"
  "OFFLINE"
}

Enum "manifest_type" {
  "INBOUND_FEEDER"
  "OUTBOUND_DISPATCH"
}

Enum "manifest_status" {
  "MENUNGGU_KEDATANGAN"
  "MENUNGGU_KONFIRMASI"
  "SUDAH_DITERIMA"
  "SIAP_BERANGKAT"
  "DALAM_PENGANTARAN"
  "SELESAI"
}

Enum "service_level" {
  "SAME_DAY"
  "NEXT_DAY"
  "REGULAR"
}

Enum "package_status" {
  "IN_TRANSIT"
  "IN_HUB"
  "OUT_FOR_DELIVERY"
  "DELIVERED"
}

Enum "dispatch_status" {
  "PENDING_ACCEPT"
  "ACCEPTED"
  "TIMEOUT_FAILED"
}

Enum "notification_type" {
  "INFO"
  "WARNING"
  "CRITICAL"
  "SUCCESS"
}

Table "hubs" {
  "id" VARCHAR(50) [pk]
  "name" VARCHAR(255) [not null]
  "region_name" VARCHAR(100) [not null]
  "location_tag" VARCHAR(50) [not null]
  "max_capacity" INT [not null]
  "timezone" VARCHAR(50) [not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "users" {
  "id" VARCHAR(50) [pk]
  "nik" VARCHAR(50) [unique, not null]
  "name" VARCHAR(255) [not null]
  "role" user_role [not null]
  "hub_id" VARCHAR(50)
  "password_hash" TEXT [not null]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "couriers" {
  "id" VARCHAR(50) [pk]
  "name" VARCHAR(255) [not null]
  "fleet_type" courier_fleet_type [not null]
  "status" courier_status [not null]
  "current_hub_id" VARCHAR(50)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "manifests" {
  "manifest_code" VARCHAR(50) [pk]
  "type" manifest_type [not null]
  "origin_hub_id" VARCHAR(50) [not null]
  "destination_hub_id" VARCHAR(50)
  "vehicle_plate" VARCHAR(20)
  "vehicle_type" VARCHAR(50)
  "status" manifest_status [not null]
  "eta_timestamp" TIMESTAMP
  "operator_id" VARCHAR(50)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (status, destination_hub_id) [name: "idx_manifests_status_hub"]
  }
}

Table "packages" {
  "tracking_id" VARCHAR(50) [pk]
  "current_hub_id" VARCHAR(50) [not null]
  "destination_area" VARCHAR(255)
  "service_type" service_level [not null]
  "status" package_status [not null]
  "hub_arrival_timestamp" TIMESTAMP
  "sla_deadline" TIMESTAMP
  "is_priority" BOOLEAN [default: false]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]

  Indexes {
    (status, current_hub_id) [name: "idx_packages_status_hub"]
    (is_priority, sla_deadline) [name: "idx_packages_sla_priority"]
  }
}

Table "manifest_packages" {
  "id" BIGSERIAL [pk, increment]
  "manifest_code" VARCHAR(50)
  "tracking_id" VARCHAR(50)
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "courier_dispatches" {
  "dispatch_id" VARCHAR(50) [pk]
  "courier_id" VARCHAR(50) [not null]
  "manifest_code" VARCHAR(50) [not null]
  "acceptance_timeout_minutes" INT [not null]
  "status" dispatch_status [not null]
  "dispatched_at" TIMESTAMP
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
  "updated_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Table "hub_notifications" {
  "id" UUID [pk, default: `gen_random_uuid()`]
  "hub_id" VARCHAR(50) [not null]
  "title" VARCHAR(100) [not null]
  "message" TEXT [not null]
  "type" notification_type [default: 'INFO']
  "is_read" BOOLEAN [default: false]
  "created_at" TIMESTAMP [default: `CURRENT_TIMESTAMP`]
}

Ref: "hubs"."id" < "users"."hub_id"

Ref: "hubs"."id" < "couriers"."current_hub_id"

Ref: "hubs"."id" < "manifests"."origin_hub_id"

Ref: "hubs"."id" < "manifests"."destination_hub_id"

Ref: "users"."id" < "manifests"."operator_id"

Ref: "hubs"."id" < "packages"."current_hub_id"

Ref: "manifests"."manifest_code" < "manifest_packages"."manifest_code" [delete: cascade]

Ref: "packages"."tracking_id" < "manifest_packages"."tracking_id" [delete: cascade]

Ref: "couriers"."id" < "courier_dispatches"."courier_id"

Ref: "manifests"."manifest_code" < "courier_dispatches"."manifest_code"

Ref: "hubs"."id" < "hub_notifications"."hub_id"

